# Port number for the backend Express server to listen on
PORT=5001

# Application execution environment (development, production, test)
NODE_ENV=development

# Allowed origin URL for CORS requests from frontend client
CLIENT_URL=http://localhost:5173

# MongoDB connection string URI including database name
MONGO_URI=mongodb://localhost:27017/Expense_Tracker

# Secret key used for signing JWT authentication tokens (minimum 32 characters)
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long

# Cloudinary cloud name for profile image cloud storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API key for authentication with Cloudinary services
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Cloudinary API secret key for signed image uploads
CLOUDINARY_API_SECRET=your_cloudinary_api_secret